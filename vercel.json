{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".output",
  "headers": [
    {
      "source": "/(fonts|images|assets)/(.+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|gif|webp|ico|svg|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
